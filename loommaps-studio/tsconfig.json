{
  "compilerOptions": {
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "types": [],
    "paths": {
      "@effectbuilder/*": ["../effectbuilder-studio/src/app/effects/*"],
      "@effectbuilder-controls": ["../effectbuilder-studio/src/app/shared/components/layer-controls/layer-controls.component.ts"],
      "@angular/*": ["./node_modules/@angular/*"],
      "@babylonjs/*": ["./node_modules/@babylonjs/*"],
      "ng-primitives/*": ["./node_modules/ng-primitives/*"]
    },
    "outDir": "out-tsc"
  },
  "angularCompilerOptions": {
    "strictTemplates": true,
    "strictInjectionParameters": true
  },
  "files": [
    "src/main.ts"
  ]
}
